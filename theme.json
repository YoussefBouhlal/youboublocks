{
    "$schema": "https://schemas.wp.org/wp/6.0/theme.json",
    "version": 2,
    "settings": {
        "appearanceTools": true,
		"color": {
			"defaultDuotone": false,
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{
					"color": "#231F20",
					"name": "Heading",
					"slug": "heading"
				},
				{
					"color": "#635D53",
					"name": "Text",
					"slug": "text"
				},
				{
                    "color": "#806900",
					"name": "Link",
					"slug": "link"
				},
				{
					"color": "#231F20",
					"name": "Dark Background",
					"slug": "dark-bg"
				},
				{
					"color": "#E9E9e9",
					"name": "Light Background",
					"slug": "light-bg"
				},
				{
					"color": "#FFFFFF",
					"name": "White",
					"slug": "white"
				}
			]
		},
        "layout": {
			"contentSize": "800px",
			"wideSize": "1200px"
		},
        "spacing": {
            "padding": false,
            "margin": false,
            "blockGap": null
		},
        "typography": {
            "fontFamilies": [
                {
                    "fontFamily": "-apple-system, \"system-ui\", \"Segoe UI\", Roboto, Oxygen-Sans, Ubuntu, Cantarell, \"Helvetica Neue\", sans-serif",
					"name": "System",
					"slug": "system"
                }
            ],
            "fontSizes": [
                {
					"name": "P",
					"size": "1rem",
					"slug": "p"
				},
                {
					"name": "H3",
					"size": "1rem",
					"slug": "h3"
				},
                {
					"name": "H2",
					"size": "1.684rem",
					"slug": "h2"
				},
                {
					"name": "H1",
					"size": "2.632rem",
					"slug": "h1"
				}
            ]
        }
    },
    "styles": {
        "color": {
            "background": "var(--wp--preset--color--white)",
            "text": "var(--wp--preset--color--text)"
        },
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--system)",
            "fontSize": "19px",
            "fontStyle": "normal",
            "fontWeight": "400",
            "lineHeight": "1.8"
        },
        "spacing": {
            "padding": {
                "top": "20px",
                "right": "20px",
                "left": "20px"
            }
        },
        "blocks": {
            "core/navigation-link": {
                "spacing": {
                    "margin": {
                        "top": "0.368rem",
                        "bottom": "0.368rem",
                        "left": "1.053rem",
                        "right": "1.053rem"
                    },
                    "padding": {
                        "top": "0.263rem",
                        "bottom": "0.263rem",
                        "left": "0.263rem",
                        "right": "0.263rem"
                    }
                },
				"color": {
					"text": "var(--wp--preset--color--heading)"
                }
            },
            "core/paragraph": {
                "spacing": {
                    "margin": {
                        "top": "2.632rem",
                        "bottom": "2.632rem"
                    }
                }
            },
            "core/post-title": {
                "color": {
                    "text": "var(--wp--preset--color--heading)"
                },
                "elements": {
                    "link": {
                        "color": {
                            "text": "var(--wp--preset--color--heading)"
                        }
                    }
                }
            },
            "core/post-date": {
                "color": {
                    "text": "var(--wp--preset--color--text)"
                }
            },
            "core/image": {
                "spacing": {
                    "margin": {
                        "top": "1.842rem",
                        "bottom": "1.842rem"
                    }
                },
                "border": {
                    "radius": "10px"
                }
            }
        },
        "elements": {
            "link": {
                "color": {
                    "text": "var(--wp--preset--color--link)"
                }
            }
        }
    },
    "customTemplates": [],
    "templateParts": [
        { "name": "header", "title": "Header", "area": "header" },
        { "name": "footer", "title": "Footer", "area": "footer" }
    ],
    "patterns": []
}